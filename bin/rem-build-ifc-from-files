# Remote IFC Build Script
#
# usage: rem-build-ifc-from-files [*] file_name [additional_files...]
#
# Wraps rem-build-ifc, processing only the specified files.

# Creating a temporary working directory on the system that will hold only the
# specified files.
tmp_dir=$(mktemp -d)

# Register cleanup for said temporary directory.
function cleanup() {
  rm -rf $tmp_dir
}

trap cleanup EXIT

# Pull out anything preceding the list of files.
flags=()
while (( $# > 0 )); do
  if [ -f "$1" ]; then
    break
  fi

  # This wasn't a file, append to flags.
  flags+=($1)
  shift
done

# Check to make sure we have at least one file left.
if (( $# == 0 )); then
  echo "No files found for given arguments."
  exit
fi

# Copy all specified files to the tempoary directory.
cp "$@" "$tmp_dir"

# Run rem-build-ifc in the temporary directory with the first argument as the
# build target.
pushd "$tmp_dir" > /dev/null
  rem-build-ifc ${flags[@]} $1
popd > /dev/null

# Finish by moving any created IFC files back to the current directory.
mv $tmp_dir/*.ifc .
